#!/usr/bin/env bash
set -euo pipefail
REPO_URL="${OMARCHY_MAC_SCROLLING_REPO:-https://github.com/joshuaswarren/omarchy-mac-scrolling}"
if ! command -v hyprpm >/dev/null 2>&1; then
  echo "omarchy-mac-scrolling: hyprpm not found" >&2
  exit 1
fi

_headers="/var/cache/hyprpm/$(id -un)/headersRoot/share/pkgconfig/hyprland.pc"
if [[ ! -f "${_headers}" ]]; then
  hyprpm update -n || true
  if [[ ! -f "${_headers}" ]]; then
    hyprpm update -n || true
  fi
  if [[ ! -f "${_headers}" ]]; then
    echo "omarchy-mac-scrolling: hyprpm update failed (headers missing)" >&2
    exit 1
  fi
else
  hyprpm update -n 2>/dev/null || true
fi

if ! hyprpm list 2>/dev/null | grep -F 'omarchy-mac-scrolling' >/dev/null; then
  printf 'y\n' | hyprpm add "${REPO_URL}"
else
  echo "omarchy-mac-scrolling: hyprpm repo already registered"
fi

echo 'To enable scrolling: hyprpm enable momentum && hyprpm reload'